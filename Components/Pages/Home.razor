    async Task RequestTreeDeletion(string kind,string id,string? sid=null)
    {
        if(EditingBlocked()||operation is not null||pickingSketchPlane)return;
        if(editing is not null&&(kind=="feature"||editing.Id!=(sid??id)))return;
        if(kind=="sketch"&&!doc.Sketches.Any(s=>s.Id==id)||kind=="feature"&&!doc.Features.Any(f=>f.Id==id)||kind=="entity"&&!doc.Sketches.Any(s=>s.Id==sid&&s.Entities.Any(e=>e.Id==id)))return;
        var plan=CadDeletionPlan.Create(doc,kind,id,sid);
        deletionPlan=plan;deletionError=null;
        if(!plan.HasDependents)await ConfirmTreeDeletion();
    }
    async Task ConfirmTreeDeletion()
    {
        if(deletionPlan is not {} plan||EditingBlocked())return;
        var ok=await Mutate(()=>{plan.Apply(doc);ResetSelection();},"对象已删除，相关约束已清理 · 可撤销恢复");
        if(ok){deletionPlan=null;deletionError=null;}else deletionError=message;
    }
    async Task DeleteProfile(){if(selectedSketch is {} sketch&&entity is {} selected)await DeleteTreeEntity((sketch.Id,selected.Id));}
    async Task Rename(ChangeEventArgs e) => await Mutate(() => doc.Name = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? "未命名零件" : e.Value.ToString()![..Math.Min(40,e.Value.ToString()!.Length)], "项目名称已更新");
    void ResetSelection() { selectedBodyId=null;selectedFacePoint=null;editingFeatureId=null;modelFaceSelected=false;historyFeatureId=null;pickingSketchPlane=false;operation=null; pickingTarget=false;targetFace=null;endCondition="blind";reversed=false;previewState=new();sketchId=editing?.Id; profileId=null; edgeIndex=null; regionKeys.Clear(); regions.Clear(); support=editing?.Plane; tool="select"; revision++; }
    async Task Undo() {await RestoreHistory(false);}
    async Task Redo() {await RestoreHistory(true);}
    async Task RestoreHistory(bool forward)
    {
        if(operation is not null||EditingBlocked())return;
        var source=forward?redo:undo;var target=forward?undo:redo;
        if(!source.TryPop(out var snapshot))return;
        documentBusy=true;
        try{target.Push(Snapshot());doc=JsonSerializer.Deserialize<CadDocument>(snapshot)!;ResetSelection();message=forward?"已重做":"已撤销";await Checkpoint();await Render();}
        finally{documentBusy=false;}
    }
    async Task<bool> FlushBeforeSwitch()
    {
        if(projectRestoreFailed){
            if(protectBrowserDraft){
                if(!await BrowserAsync<bool>("preserveRecoveryDraft")){message="旧草稿备份失败，暂不能切换项目，请先下载备份。";return false;}
                protectBrowserDraft=false;
            }
            return true;
        }
        if(storageConflict){message="当前项目有版本冲突，请先另存为项目或下载备份。";return false;}
        if(serverRevision==0&&!pendingSave&&doc.Sketches.Count==0&&doc.Features.Count==0)return true;
        await WriteProjectDraft(Snapshot()!=savedSnapshot);
        return await SaveToBackend();
    }
    async Task<bool> AdoptNewDocument(CadDocument next,string success)
    {
        if(EditingBlocked()||!await FlushBeforeSwitch())return false;
        if(module is null||!await InvokeView("prepareLoadedDocument",next))return false;
        projectId=Guid.NewGuid();serverRevision=0;savedSnapshot="";lastSavedAt=null;storageConflict=false;projectRestoreFailed=false;requiresRepair=false;storageMessage=null;protectBrowserDraft=false;
        doc=next;ResetSelection();undo.Clear();redo.Clear();showProjects=false;message=success;
        documentBusy=true;
        try{await Checkpoint();await Render();await Camera(editing is null?"iso":"sketch");return true;}
        finally{documentBusy=false;}
    }
    void BeginNewProject(){if(EditingBlocked())return;projectNameMode="new";projectNameInput="新建零件";}
    void BeginRenameProject(){if(EditingBlocked())return;projectNameMode="rename";projectNameInput=doc.Name;}
    void BeginSaveAs(){if(EditingBlocked())return;if(projectRestoreFailed){message="当前项目未恢复，不能把空白视图另存为原项目副本。请新建或打开项目。";return;}projectNameMode="copy";projectNameInput=(doc.Name.Length>35?doc.Name[..35]:doc.Name)+" 副本";}
    async Task ProjectNameKey(KeyboardEventArgs e){if(e.Key=="Enter")await ConfirmProjectName();else if(e.Key=="Escape")projectNameMode=null;}
    async Task ConfirmProjectName(){
        if(EditingBlocked()||string.IsNullOrWhiteSpace(projectNameInput))return;
        var name=projectNameInput.Trim();if(name.Length>40)name=name[..40];
        if(projectNameMode=="new"){if(await AdoptNewDocument(new CadDocument{Name=name},"项目已创建 · 编辑内容自动保存"))projectNameMode=null;}
        else if(projectNameMode=="rename"){if(await Mutate(()=>doc.Name=name,"当前零件已重命名 · 自动保存"))projectNameMode=null;}
        else if(projectNameMode=="copy"){await SaveCopy(name);projectNameMode=null;}
    }
    async Task Save()
    {
        if(EditingBlocked())return;
        await WriteProjectDraft(Snapshot()!=savedSnapshot);
        if(await SaveToBackend())message="项目已保存到后端";
    }
    async Task SaveCopy(string name)
    {
        if(EditingBlocked())return;
        doc=JsonSerializer.Deserialize<CadDocument>(Snapshot())!;doc.Name=name;undo.Clear();redo.Clear();
        projectId=Guid.NewGuid();serverRevision=0;savedSnapshot="";lastSavedAt=null;storageConflict=false;projectRestoreFailed=false;requiresRepair=false;storageMessage=null;protectBrowserDraft=false;
        await WriteProjectDraft(true);
        if(await SaveToBackend()){showProjects=false;message="已另存为独立项目";}
    }
    async Task DownloadProject(){if(!EditingBlocked())await InvokeView("download",doc.Name+".cad.json",Snapshot(),"application/json");}
    async Task ShowProjectBrowser()
    {
        if(EditingBlocked())return;
        try{savedProjects=await Projects.ListAsync();showProjects=true;}
        catch(Exception ex) when(ex is IOException or UnauthorizedAccessException or JsonException or ArgumentException){Logger.LogError(ex,"CAD project list failed");storageMessage="无法读取后端项目列表，请检查存储目录权限。";}
    }
    void DeleteCurrentProject(){if(EditingBlocked()||serverRevision<1)return;RequestProjectDeletion(new(projectId,doc.Name,serverRevision,lastSavedAt??DateTimeOffset.UtcNow,doc.Sketches.Count,doc.Features.Count));}
    void RequestProjectDeletion(CadProjectSummary item){if(EditingBlocked())return;projectToDelete=item;projectDeleteError=null;}
    async Task ConfirmProjectDeletion()
    {
        if(EditingBlocked()||projectToDelete is not {} item)return;
        documentBusy=true;
        try{
            await Projects.DeleteAsync(item.Id,item.Revision);
            if(item.Id==projectId){
                doc=new();projectId=Guid.NewGuid();serverRevision=0;savedSnapshot="";pendingSave=false;requiresRepair=false;storageConflict=false;projectRestoreFailed=false;storageMessage=null;lastSavedAt=null;protectBrowserDraft=false;
                ResetSelection();undo.Clear();redo.Clear();deletionPlan=null;message="项目已删除 · 可新建项目继续建模";
            }
            projectToDelete=null;projectDeleteError=null;
            if(CanUseBrowser)await BrowserVoidAsync("forgetProject",item.Id.ToString("D"));
            savedProjects=await Projects.ListAsync();await Render();
        }catch(CadProjectConflictException ex){projectDeleteError=ex.Message;try{savedProjects=await Projects.ListAsync();}catch(Exception refreshError) when(refreshError is IOException or UnauthorizedAccessException or JsonException or ArgumentException){Logger.LogWarning(refreshError,"Project list refresh after delete conflict failed");}}
        catch(Exception ex) when(ex is IOException or UnauthorizedAccessException or JsonException or ArgumentException){Logger.LogError(ex,"CAD project deletion failed");projectDeleteError="删除未完成："+ex.Message;}
        catch(OperationCanceledException) when(!CanUseBrowser){}
        finally{documentBusy=false;RefreshUi();}
    }
    async Task LoadProject(Guid id)
    {
        if(EditingBlocked()||!await FlushBeforeSwitch())return;
        documentBusy=true;
        try{
            var loaded=await Projects.LoadAsync(id)??throw new ArgumentException("项目文件已不存在。");
            if(!await InvokeView("prepareLoadedDocument",loaded.Document))return;
            doc=loaded.Document;projectId=loaded.Id;serverRevision=loaded.Revision;lastSavedAt=loaded.SavedAt;savedSnapshot=Snapshot();pendingSave=false;storageConflict=false;projectRestoreFailed=false;protectBrowserDraft=false;requiresRepair=loaded.RecoveredBackup;storageMessage=null;
            ResetSelection();undo.Clear();redo.Clear();showProjects=false;message="已打开后端项目";
            await WriteProjectDraft(false);if(requiresRepair)await SaveToBackend();await Render();await Camera(editing is null?"iso":"sketch");
        }catch(Exception ex) when(ex is IOException or UnauthorizedAccessException or JsonException or ArgumentException){Logger.LogError(ex,"CAD project open failed");storageMessage="打开失败："+ex.Message;}
        finally{documentBusy=false;}
    }
    async Task Open(InputFileChangeEventArgs e)
    {
        if(EditingBlocked())return;
        try { using var stream=e.File.OpenReadStream(CadProjectStore.MaxDocumentBytes); var loaded=await JsonSerializer.DeserializeAsync<CadDocument>(stream); if(loaded is null) throw new ArgumentException("文件为空。"); loaded.Validate(); await AdoptNewDocument(loaded,"已导入为独立项目"); }
        catch(Exception ex) when(ex is JsonException or ArgumentException or IOException) { message="导入失败："+ex.Message; }
    }
    bool exportingStl;
    int stlExportId;
    async Task Export()
    {
        if(EditingBlocked())return;
        if(exportingStl){message="导出仍在计算中，请等待进度更新。";return;}
        if(doc.Features.Count==0 || editing is not null || operation is not null) { message="请先结束草图并确认实体特征。"; return; }
        exportingStl=true;stlExportId++;message="正在生成包含倒角的 STL 网格…";RefreshUi();
        if(!await InvokeView("exportStl",doc.Name,stlExportId))exportingStl=false;
    }
    async Task CancelStlExport(){if(await InvokeView("cancelStlExport")){stlExportId++;exportingStl=false;message="已取消导出。";}}
    [JSInvokable]
    public Task StlExportProgress(string status,bool finished,int exportId)=>InvokeAsync(()=>{if(disposed||exportId!=stlExportId)return;message=status;if(finished)exportingStl=false;RefreshUi();});
    async Task<bool> InvokeView(string method,params object?[] args)
    {
        if(module is null||!CanUseBrowser)return false;
        try{await BrowserVoidAsync(method,args);return true;}
        catch(OperationCanceledException) when(!CanUseBrowser){return false;}
        catch(Exception ex) when(ex is JSException or OperationCanceledException){Logger.LogWarning(ex,"CAD view operation {Method} failed",method);message="操作未完成："+ex.Message;return false;}
    }
    async Task Fit() {await InvokeView("fit");}
    bool debugMode;
    async Task ToggleDebugMode(){if(await InvokeView("setDebugMode",!debugMode))debugMode=!debugMode;}
    async Task Camera(string view) {await InvokeView("cameraView",view);}
    void RefreshUi(){if(CanUseBrowser)StateHasChanged();}
    async ValueTask<T> BrowserAsync<T>(string method,params object?[] args)
    {
        if(!CanUseBrowser||module is null)throw new OperationCanceledException("浏览器连接已结束。");
        try{return await module.InvokeAsync<T>(method,args);}
        catch(JSDisconnectedException){CircuitState.MarkDisconnected();throw new OperationCanceledException("浏览器连接已结束。");}
    }
    async ValueTask BrowserVoidAsync(string method,params object?[] args)
    {
        if(!CanUseBrowser||module is null)throw new OperationCanceledException("浏览器连接已结束。");
        try{await module.InvokeVoidAsync(method,args);}
        catch(JSDisconnectedException){CircuitState.MarkDisconnected();throw new OperationCanceledException("浏览器连接已结束。");}
    }
    public ValueTask DisposeAsync()
    {
        // Browser-owned observers release WebGL and DOM handlers on removal/pagehide.
        // No JS interop (including module disposal) is legal after a refresh disconnect.
        disposed=true;reference?.Dispose();reference=null;module=null;
        return ValueTask.CompletedTask;
    }

