    async Task<bool> ApplyDimensionValue(string sid,string pid,int edge,double value)
    {
        if(operation is not null||pickingSketchPlane||pickingTarget||(editing is not null&&editing.Id!=sid)){message="请先结束当前操作再修改尺寸。";return false;}
        var sketch=doc.Sketches.FirstOrDefault(s=>s.Id==sid);var e=sketch?.Entities.FirstOrDefault(e=>e.Id==pid);
        if(e is null||(edge < -1&&!e.ModelDimensions.Any(d=>d.Index==edge))||edge>=e.EdgeCount||(edge==-1&&e.ReferenceLineId is null)){message="标注来源已失效。";return false;}
        if(!double.IsFinite(value)){message="请输入有效尺寸。";return false;}
        if(edge>=0&&!e.DimensionedEdges.Contains(edge)){message="此尺寸尚未标注，请在图元属性中修改参数，或明确添加尺寸标注。";return false;}
        return await Mutate(()=>{
            if(edge < -1) {if(value<0)throw new ArgumentException("边间距不能小于 0 mm。");e.ModelDimensions.First(d=>d.Index==edge).Distance=value;}
            else if(edge==-1)e.ReferenceOffset=value;
            else {
                var anchor=e.Anchor();
                if(e.Kind=="circle")e.Radius=value/2;else if(e.Kind=="arc")e.Radius=value;else if(e.Kind=="polygon")e.Radius=value/(2*Math.Sin(Math.PI/e.Sides));
                else if(e.Kind=="line"){if(value<1)throw new ArgumentException("直线长度至少为 1 mm。");var length=EdgeValue(e,0);e.Width*=value/length;e.Height*=value/length;}
                else if(edge%2==0)e.Width=value;else e.Height=value;
                e.KeepAnchor(anchor);
            }
            sketchId=sid;profileId=pid;edgeIndex=edge>=0?edge:null;support=sketch!.Plane;historyFeatureId=null;modelFaceSelected=false;
        },"标注尺寸已更新 · 后续特征已重建");
    }
