@page "/"
@using BlazorCAD.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject CadProjectStore Projects
@inject CadCircuitState CircuitState

<PageTitle>FORMA · 参数化建模工作台</PageTitle>
<div class="studio" aria-busy="@(initializing || documentBusy)">
    <header class="header">
        <a class="brand" href="/"><CadIcon Name="box" /><span>FORMA<span class="brand-dot">CAD</span></span></a>
        <div class="divider"></div><div class="quick-history" role="group" aria-label="撤销与重做"><button title="撤销" aria-label="撤销" disabled="@(undo.Count==0||operation is not null||initializing||documentBusy)" @onclick="Undo"><CadIcon Name="undo" /></button><button title="重做" aria-label="重做" disabled="@(redo.Count==0||operation is not null||initializing||documentBusy)" @onclick="Redo"><CadIcon Name="redo" /></button></div><button class="project project-rename" title="重命名当前零件" aria-label="重命名当前零件" disabled="@(initializing||documentBusy||saving)" @onclick="BeginRenameProject">@doc.Name <span class="filetype">.cad</span></button><span class="document-tag">参数化零件</span><span class="storage-state @(pendingSave||storageConflict?"pending":"")" role="status" title="@(lastSavedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))">@StorageLabel</span>

        <div class="header-actions"><button title="新建项目" @onclick="BeginNewProject"><CadIcon Name="file" /><span>新建</span></button><button @onclick="ShowProjectBrowser"><CadIcon Name="open" /><span>打开</span></button><button disabled="@(initializing||documentBusy||saving)" @onclick="BeginSaveAs"><CadIcon Name="save" /><span>另存为</span></button><button disabled="@(initializing||documentBusy||saving||serverRevision==0)" title="删除当前项目" @onclick="DeleteCurrentProject"><CadIcon Name="delete" /><span>删除项目</span></button><button disabled="@(documentBusy||saving||!doc.Features.Any(f=>f.Mode=="chamfer"&&!f.VisualOnly))" title="把无下游面引用的旧倒角转为轻量外观处理，可撤销" @onclick="ConvertVisualEdges">轻量边缘</button><button disabled="@exportingStl" @onclick="Export"><CadIcon Name="export" /><span>导出 STL</span></button>@if(exportingStl){<button @onclick="CancelStlExport">取消导出</button>}</div>
    </header>
    <nav class="toolbar ribbon" aria-label="建模工具栏">
        <div class="ribbon-group sketch-lifecycle">
            <div class="ribbon-commands">
                <button class="ribbon-command primary-sketch @(editing is not null||pickingSketchPlane?"active":"")" aria-label="@(editing is not null||pickingSketchPlane?"完成编辑":"编辑草图")" title="@(editing is not null?"完成编辑；有图元保留草图，没有图元直接退出":pickingSketchPlane?"完成编辑并取消选面":"编辑选中草图，或选择一个面开始绘制")" disabled="@(operation is not null||initializing||documentBusy)" @onclick="ToggleSketchEditing"><CadIcon Name="@(editing is not null||pickingSketchPlane?"finish":"sketch")" /><span>@(editing is not null||pickingSketchPlane?"完成编辑":"编辑草图")</span></button>
            </div><div class="ribbon-caption">草图</div>
        </div>
        <SketchPalette SelectedTool="@tool" Disabled="@(editing is null||operation is not null||initializing||documentBusy)" OnSelect="SetTool" />
        <div class="ribbon-group selection-tools"><div class="ribbon-commands">
            <button class="ribbon-command @(tool=="select"?"active":"")" title="选择图元与轮廓" disabled="@(operation is not null)" @onclick='()=>SetTool("select")'><CadIcon Name="select" /><span>选择</span></button>
            <button class="ribbon-command dimension-command @(tool=="dimension"?"active":"")" title="选择边并放置尺寸" disabled="@(editing is null)" @onclick='()=>SetTool("dimension")'><CadIcon Name="dimension" /><span>智能尺寸</span></button>
        </div><div class="ribbon-caption">选择与尺寸</div></div>
        <FeaturePalette CanGenerate="CanFeature" CanLoft="CanSweep" CanSweep="CanSweep" HasSolid="@(doc.Features.Count>0)" Disabled="@(editing is not null||operation is not null||pickingSketchPlane||initializing||documentBusy||saving)" OnStart="StartFeatureMode" />
        <div class="ribbon-group view-tools"><div class="ribbon-commands">
            <button class="ribbon-command" title="正对草图平面" @onclick='() => Camera("sketch")'><CadIcon Name="align" /><span>正对草图</span></button>
            <button class="ribbon-command" title="透视自由视图" @onclick='() => Camera("iso")'><CadIcon Name="box" /><span>自由视图</span></button>
            <button class="ribbon-command" title="适合窗口" @onclick="Fit"><CadIcon Name="fit" /><span>适合窗口</span></button>
            <button class="ribbon-command @(debugMode?"active":"")" aria-pressed="@debugMode" title="显示实际三角网格：青绿为可见线，洋红为被遮挡线" @onclick="ToggleDebugMode"><span>Debug 网格</span></button>
        </div><div class="ribbon-caption">视图</div></div>
        <div class="ribbon-state"><span class="live-dot"></span><strong>@(editing is not null ? "草图编辑" : pickingSketchPlane ? "选择承载面" : "零件建模")</strong><small>长度单位 · mm</small></div>
    </nav>
    <aside class="left-panel">
        <div class="panel-title"><span class="panel-heading"><CadIcon Name="history" />建模历史</span><span class="panel-count">@doc.Features.Count 步</span></div>
        <FeatureHistory Document="doc" SelectedSketchId="@sketchId" SelectedEntityId="@profileId" SelectedFeatureId="@historyFeatureId" EditingId="@(editing?.Id)" PickingPlane="pickingSketchPlane" Disabled="@(operation is not null||initializing||documentBusy||saving)" OnPlane="SelectPlane" OnSketch="SelectSketch" OnFeature="SelectHistoryFeature" OnEntity="SelectHistoryEntity" OnEditFeature="EditHistoryFeature" OnEditSketch="EditHistorySketch" OnEditEntity="EditHistoryEntity" OnDimension="EditHistoryDimension" OnToggleVisibility="ToggleSketchVisibility" OnDeleteSketch="DeleteTreeSketch" OnDeleteEntity="DeleteTreeEntity" OnDeleteCoincidence="RemoveTreeCoincidence" OnDeleteFeature="DeleteTreeFeature" OnRename="BeginRenameProject" Bodies="bodies" SelectedBodyId="@selectedBodyId" OnBody="SelectBody" OnDeleteBody="DeleteBody" />
        <div class="tree-footer"><span class="live-dot"></span><span>@(bodies.Count > 0 ? $"{bodies.Count} 个实体" : "尚未生成实体")</span><small>@doc.Sketches.Count 个草图</small></div>
    </aside>
    <main class="viewport">
        <div class="viewport-top"><div><span class="eyebrow">FORMA / 零件视图</span><h1>@Stage</h1></div><span class="mode-pill">@(editing is not null ? "草图编辑" : "零件建模")</span></div>
        <div id="cad-canvas" class="cad-canvas"></div>
        @if(debugMode){<div class="debug-wire-legend"><strong>DEBUG · 实际三角网格</strong><span style="color:#0dffb8">青绿：可见线</span><span style="color:#ff1fa6">洋红：被遮挡线</span></div>}
        @if(storageMessage is not null) {
            <div class="storage-notice" role="alert"><span>@storageMessage</span>
                @if(projectRestoreFailed){<button disabled="@(initializing||documentBusy||saving)" @onclick="BeginNewProject">新建项目</button><button disabled="@(initializing||documentBusy||saving)" @onclick="ShowProjectBrowser">打开项目</button><button disabled="@(initializing||documentBusy||saving)" @onclick="()=>LoadProject(projectId)">重新加载</button>}
                else{<button disabled="@(initializing||documentBusy||saving||storageConflict)" @onclick="Save">重试保存</button><button disabled="@(initializing||documentBusy||saving)" @onclick="BeginSaveAs">另存为项目</button>}
            </div>
        }
        <div class="canvas-label"><span class="live-dot"></span>@(editing?.Name ?? selectedSketch?.Name ?? SupportName)<span>/ @toolLabel</span></div>
        @if (doc.Sketches.Count == 0)
        {
            <div class="empty-guide @(pickingSketchPlane ? "choosing-plane" : "")"><span>@(pickingSketchPlane ? "02 / SELECT A PLANE" : "01 / NEW SKETCH")</span><h2>@(pickingSketchPlane ? "选择一个彩色网格面" : "从编辑草图开始")</h2><p>@(pickingSketchPlane ? "点击三维中的 XY、XZ 或 YZ 面，选中后自动正对并进入草图。" : "点击顶部「编辑草图」，再在三维中选择草图平面。")</p></div>
        }
        <div class="axis-legend"><span class="axis-x">X</span><span class="axis-y">Y</span><span class="axis-z">Z</span></div>
    </main>
    <aside class="right-panel"><div class="panel-title">@(operation is not null ? "特征设置" : "属性与选择") <span>⚙</span></div>
        <div class="property-body" @key="revision">
            <span class="eyebrow">参数面板</span><h2>@(operation is not null ? (editingFeatureId is not null ? "编辑 · " : "") + CurrentFeature().Label : editing is not null ? "编辑草图" : "当前选择")</h2>
            @if (operation is not null)
            {
                @if(featureMode=="chamfer"){<div class="selection-card">@(chamferEdges.Count==0?"点击直边或圆形边界，可连续选择多条":"已选择 "+chamferEdges.Count+" 条边 · 再点可取消")</div>}
                else if(featureMode=="sweep"&&thinWall){<div class="selection-card">开放截面 · 薄壁扫描</div>}
                else {<div class="selection-card">已选择 @regionKeys.Count 个封闭区域</div>}
                @if(editingFeatureId is not null&&featureMode!="chamfer") { <button class="wide-button secondary" @onclick="EditFeatureSourceSketch">编辑来源草图尺寸</button> }
                @if(featureMode=="extrude") {
                <label class="field-label" for="end-condition">终止条件</label>
                <select id="end-condition" class="text-input" value="@endCondition" @onchange="SetEndCondition">
                    <option value="blind">指定距离</option>
                    <option value="throughAll" disabled="@(doc.Features.Count == 0)">贯穿全部</option>
                    <option value="upToFace" disabled="@(doc.Features.Count == 0)">到指定面</option>
                </select>
                <label class="check-field"><input id="feature-reversed-input" type="checkbox" checked="@reversed" @onchange="SetReversed" />反向</label>
                @if (endCondition == "blind")
                {
                    <label class="number-field"><span>距离</span><input id="feature-depth-input" type="number" min="-1000" max="1000" step="0.1" value="@N(reversed?-distance:distance)" @onchange="SetDistance" /><small>mm</small></label><p class="description">拖动游标越过草图平面可反向，负数表示反向距离。</p>
                }
                else if (endCondition == "upToFace")
                {
                    <button class="wide-button secondary @(pickingTarget ? "picking" : "")" @onclick="BeginTargetPick">@(pickingTarget ? "请在画布点击终止面…" : targetFace is null ? "选择终止面" : "重新选择终止面")</button>
                    <div class="selection-card">@(targetFace is null ? "尚未选择终止面" : "终止平面已选中（蓝色）")</div>
                }
                }
                else if(featureMode=="revolve") {
                    <p class="description">截面保持原尺寸对齐到参照轴所在平面后旋转，原草图不缩放。</p>
                    <label class="field-label">旋转轴</label><select class="text-input" value="@(rotationAxisSelected?(axisModelEdge is not null?"model":axisEntityId is null?axis:(axisSketchId??sketchId)+"|"+axisEntityId+"|"+axisEdgeIndex):"")" @onchange="SetRevolveAxis"><option value="">在视口点击草图直边、参考线或实体直边</option>@if(axisModelEdge is not null){<option value="model">已选择实体直边</option>}<option value="X">草图 X 轴</option><option value="Y">草图 Y 轴</option>@foreach(var axisSketch in doc.Sketches.Where(s=>s.Finished)){@foreach(var shape in axisSketch.Entities){@foreach(var axisEdge in shape.RotationEdges){<option value="@(axisSketch.Id+"|"+shape.Id+"|"+axisEdge)">@axisSketch.Name · @(shape.Kind=="line"?(shape.Construction?"参考线":"直线"):shape.Kind=="rectangle"?"矩形边":shape.Kind=="polygon"?"多边形边":"槽直边") @(axisSketch.Entities.IndexOf(shape)+1) · @(axisEdge+1)</option>}}}</select>
                    <button class="wide-button secondary @(pickingRotationAxis?"picking":"")" @onclick="BeginRotationAxisPick">@(pickingRotationAxis?"点击任意草图直边、参考线或实体直边…":"选择 / 更换旋转参照线")</button>
                    @if(rotationAxisSelected&&axisEntityId is null&&axisModelEdge is null){<label class="number-field"><span>轴偏移</span><input type="number" min="-1000" max="1000" value="@N(axisOffset)" @onchange="SetAxisOffset" /><small>mm</small></label>}
                    <label class="number-field"><span>旋转角度</span><input type="number" min="1" max="360" value="@N(revolveAngle)" @onchange="SetRevolveAngle" /><small>°</small></label><label class="check-field"><input id="feature-reversed-input" type="checkbox" checked="@reversed" @onchange="SetReversed" />反向</label>
                }
                else if(featureMode=="sweep") {
                    <div class="section-label">① 闭合截面</div>
                    <button class="wide-button secondary @(sweepPickRole=="profile"?"picking":"")" @onclick='()=>BeginSweepPick("profile")'>@(sweepPickRole=="profile"?"点击三维中的闭合轮廓…":"选择 / 更换截面")</button>
                    <label class="field-label">截面草图</label><select class="text-input" value="@(sketchId??"")" @onchange="SetSweepProfileSketch"><option value="">选择闭合截面草图</option>@foreach(var source in doc.Sketches.Where(s=>s.Finished&&(loftChoices.Any(c=>c.SketchId==s.Id)||thinWall))){<option value="@source.Id">@source.Name</option>}</select>
                    @if(!thinWall&&sketchId is not null){<label class="field-label">闭合区域</label><select class="text-input" value="@(loftChoices.FirstOrDefault(c=>c.SketchId==sketchId&&c.RegionKeys.SequenceEqual(regionKeys))?.Value??"")" @onchange="SetSweepRegion"><option value="">请在画布选择一个连通闭合区域</option>@foreach(var choice in loftChoices.Where(c=>c.SketchId==sketchId)){<option value="@choice.Value">@choice.Label</option>}</select>}
                    <div class="section-label">② 扫描路径 · 不要求闭合</div>
                    <button class="wide-button secondary @(sweepPickRole=="path"?"picking":"")" @onclick='()=>BeginSweepPick("path")'>@(sweepPickRole=="path"?"点击直线、圆弧或路径曲线…":"选择 / 更换路径")</button>
                    <label class="field-label">路径草图</label><select class="text-input" value="@(pathSketchId??"")" @onchange="SetPathSketch"><option value="">选择路径所在草图</option>@foreach(var path in doc.Sketches.Where(s=>s.Finished&&s.Id!=sketchId&&s.Entities.Any(e=>e.Kind is "line" or "arc" or "circle" or "ellipse"))){<option value="@path.Id">@path.Name</option>}</select>
                    @if(doc.Sketches.FirstOrDefault(s=>s.Id==pathSketchId) is {} pathSketch){<label class="field-label">路径曲线</label><select class="text-input" value="@(pathEntityId??"")" @onchange="SetPathEntity"><option value="">连续直线链（全部直线）</option>@foreach(var curve in pathSketch.Entities.Where(e=>e.Kind is "line" or "arc" or "circle" or "ellipse")){<option value="@curve.Id">@(curve.Kind switch{"line"=>"直线","arc"=>"圆弧","circle"=>"圆",_=>"椭圆"}) @(pathSketch.Entities.IndexOf(curve)+1)</option>}</select>}
                    <details class="sweep-extra"><summary>辅助创建路径（可选）</summary>
                        <label class="number-field"><span>路径长度</span><input type="number" min="1" max="1000" value="@N(centerPathLength)" @onchange="SetCenterPathLength" /><small>mm</small></label>
                        <label class="number-field"><span>偏离法线</span><input type="number" min="-180" max="180" value="@N(centerPathAngle)" @onchange="SetCenterPathAngle" /><small>°</small></label>
                        <button class="wide-button secondary" disabled="@(sketchId is null||thinWall||regionKeys.Count==0||documentBusy||saving)" @onclick="CreateCenterSweepPath">@(CenterSweepPath is null?"从截面中心创建路径":"更新中心路径")</button>
                        <p class="description">0° 沿截面法线延伸，其他角度生成斜线。起点关联截面中心，路径会作为独立草图保存，可再编辑或续画折线。</p>
                    </details>
                    <label class="field-label">截面方向</label><select class="text-input" value="@sweepOrientation" @onchange="SetSweepOrientation"><option value="follow">自动对齐路径方向</option><option value="profile">保持原截面起始方向</option></select>
                    <label class="field-label">路径插值</label><select class="text-input" value="@pathInterpolation" @onchange="SetPathInterpolation"><option value="native">跟随原始路径</option><option value="spline">平滑样条路径（直线链控制点）</option></select>
                    <label class="check-field"><input type="checkbox" checked="@reversed" @onchange="SetReversed" />反向路径</label>
                    @if(previewState.Valid){<div class="sweep-preview-control"><label for="sweep-progress">截面推进预览 <span id="sweep-progress-value">0%</span></label><input id="sweep-progress" type="range" min="0" max="100" value="0" /><button class="wide-button secondary" @onclick='()=>InvokeView("playSweepGuide")'>播放 / 暂停截面推进</button></div>}
                    <p class="description">截面只提供形状，路径决定实体位置，两者无需相交或共面。截面中心自动放到路径起点，默认对齐路径方向并沿路径推进；原草图保持原位。反向路径可切换起始端。</p>
                    <details class="sweep-extra"><summary>更多：开放截面薄壁（可选）</summary><label class="check-field"><input type="checkbox" checked="@thinWall" @onchange="SetSweepThinWall" />使用开放截面加厚</label>
                    @if(thinWall&&selectedSketch is not null){<label class="field-label">开放轮廓</label><select class="text-input" value="@(openProfileEntityId??"")" @onchange="SetOpenProfileEntity"><option value="">连续直线链（非参考线）</option>@foreach(var curve in selectedSketch.Entities.Where(e=>!e.Construction&&e.Kind is "line" or "arc")){<option value="@curve.Id">@(curve.Kind=="arc"?"圆弧":"直线") @(selectedSketch.Entities.IndexOf(curve)+1)</option>}</select><label class="number-field"><span>壁厚</span><input type="number" min="0.1" max="1000" step="0.1" value="@N(wallThickness)" @onchange="SetWallThickness" /><small>mm</small></label><select class="text-input" value="@wallSide" @onchange="SetWallSide"><option value="center">对称加厚</option><option value="left">轮廓左侧</option><option value="right">轮廓右侧</option></select>}
                    </details>
                }
                else if(featureMode=="loft") {
                    <div class="section-label">截面顺序 · @(loftSections.Count+1) 个</div><div class="selection-card">01 · @selectedSketch?.Name · 起始截面</div>
                    @for(var i=0;i<loftSections.Count;i++){var index=i;var section=loftSections[i];<div class="loft-section-row"><span>@((i+2).ToString("00"))</span><strong title="@LoftSectionName(section)">@LoftSectionName(section)</strong><button class="delete-button" title="移除此截面" @onclick="()=>RemoveLoftSection(index)">✕</button></div>}
                    <p class="description" role="status">@(loftSections.Count==0?"请在三维视口点击下一个闭合草图区域或实体平面。":"可以继续点击截面，或直接确认完成放样。") 按点击顺序连接，最多 9 个截面。</p>
                }
                else if(featureMode=="chamfer") {
                    <p class="description">@(UseTopologyBevel?"实体边倒角：使用你设置的尺寸，新生成的边可以继续倒角。":CurrentFeature().VisualOnly?"轻量外观处理：实时改变边缘外观，草图参照和 STL 导出使用原始几何。":"此历史倒角面已被引用，保留实体处理以维持后续草图。")</p><label class="field-label">边缘处理</label><select class="text-input" value="@edgeTreatment" @onchange="SetEdgeTreatment"><option value="chamfer">直倒角 · 距离与角度</option><option value="fillet">圆角 · 圆弧半径</option></select>
                    <label class="number-field"><span>@(edgeTreatment=="fillet"?"圆角半径":"倒角距离")</span><input type="number" min="0.1" step="0.1" value="@N(distance)" @onchange="SetDistance" /><small>mm</small></label>
                    @if(edgeTreatment=="chamfer"){<label class="number-field"><span>角度</span><input type="number" min="1" max="89" value="@N(chamferAngle)" @onchange="SetChamferAngle" /><small>°</small></label>}
                    @if(chamferEdges.Count>0){<div class="edge-profile-editor"><div class="section-label">@(edgeTreatment=="fillet"?"圆角截面 · 拖动弧线":"倒角截面 · 拖动斜线")</div><canvas id="edge-profile-canvas" tabindex="0" aria-label="拖动截面调整边缘处理尺寸"></canvas><div id="edge-profile-error" role="status"></div><p class="description">网格单位 mm。拖动截面线调整尺寸，三维实体同步预览；Shift 精调，Esc 撤回。</p></div>}
                    @for(var i=0;i<chamferEdges.Count;i++){var index=i;<div class="constraint-property-row"><span>棱边 @(i+1)</span><button @onclick="()=>RemoveTreatmentEdge(index)">移除</button></div>}
                    <p class="description">可选择直边、圆柱端部、圆孔口及椭圆边界。曲线边整体高亮并按整条边处理，圆角由半径控制。</p>
                }
                <div class="preview-message @(!previewState.Valid ? "invalid" : "")" role="status">@previewState.Message
                    @if (previewState.Valid && featureMode=="extrude"&&endCondition != "blind") { <span>有效距离 @N(previewState.Min)–@N(previewState.Max) mm</span> }
                </div>
                <p class="description">@(featureMode=="chamfer"?(edgeTreatment=="fillet"?"拖动弧线实时查看三维圆角，R 为当前半径。确认后生成实体特征并自动保存。":"当前显示处理后的外形。确认后生成特征并自动保存。"):"绿色为增材预览，红色为减材预览。确认后生成特征并自动保存。")@if(featureMode=="extrude"){<span>指定距离可拖动画布刻度游标，Shift 精调。</span>}</p>
                <button id="feature-confirm" class="wide-button" disabled="@(!CanConfirmFeature)" @onclick="ConfirmFeature">@($"✓ 确认{CurrentFeature().Label}")</button><button class="wide-button secondary" @onclick="CancelFeature">取消</button>
            }
            else
            {
                @if (editing is null && selectedSketch is not null)
                {
                    <div class="selection-card">已选择 @regionKeys.Count 个区域 · 无需先标注尺寸</div>
                    <div class="section-label">草图属性</div>
                }
                <label class="field-label">反射环境</label><select class="text-input" value="@doc.Environment" @onchange="ChangeEnvironment"><option value="studio">工业摄影棚</option><option value="workshop">车间灯光</option><option value="soft">柔光环境</option><option value="none">无环境反射</option></select>
                @if(selectedBody is {} currentBody){
                    var appearance=BodyAppearance;
                    <div class="section-label">@currentBody.Name · 独立材质</div>
                    <button class="wide-button secondary" @onclick="()=>DeleteBody(currentBody.Id)">删除实体及关联步骤</button>
                    <label class="field-label">工业材质</label><select class="text-input" value="@appearance.Preset" @onchange="ChangeMaterialPreset"><option value="steel">不锈钢</option><option value="aluminum">铝合金</option><option value="copper">铜</option><option value="brass">黄铜</option><option value="iron">铸铁</option><option value="paint">工业烤漆</option><option value="plastic">工程塑料</option><option value="rubber">橡胶</option></select>
                    <label class="number-field"><span>颜色</span><input type="color" value="@appearance.Color" @onchange='e=>ChangeMaterial("color",e)' /></label>
                    @foreach(var parameter in new[]{("roughness","粗糙度",appearance.Roughness),("metalness","金属度",appearance.Metalness),("specular","高光强度",appearance.Specular),("clearcoat","涂层",appearance.Clearcoat),("anisotropy","拉丝强度",appearance.Anisotropy),("grain","表面细节",appearance.Grain)}){var field=parameter.Item1;<label class="number-field"><span>@parameter.Item2</span><input type="number" min="0" max="1" step="0.05" value="@N(parameter.Item3)" @onchange="e=>ChangeMaterial(field,e)" /></label>}
                    <label class="number-field"><span>拉丝方向</span><input type="number" min="-360" max="360" value="@N(appearance.BrushAngle)" @onchange='e=>ChangeMaterial("brushAngle",e)' /><small>°</small></label>
                    <label class="number-field"><span>环境反射</span><input type="number" min="0" max="3" step="0.1" value="@N(appearance.EnvironmentStrength)" @onchange='e=>ChangeMaterial("environmentStrength",e)' /></label>
                    <label class="field-label">上传颜色贴图 · PNG / JPEG / WebP</label><InputFile OnChange="UploadBodyTexture" accept="image/png,image/jpeg,image/webp" disabled="@(documentBusy||saving)" />
                    @if(appearance.TextureId is not null){<label class="field-label">自动映射</label><select class="text-input" value="@appearance.Mapping" @onchange='e=>ChangeMaterial("mapping",e)'><option value="uniform">等密度表面映射 · 保持棋盘格比例</option><option value="triplanar">三向混合 · 柔化接缝</option></select><label class="number-field"><span>贴图高度</span><input type="number" min="0.1" max="1000" step="0.1" value="@N(appearance.TextureSize)" @onchange='e=>ChangeMaterial("textureSize",e)' /><small>mm</small></label><label class="number-field"><span>贴图旋转</span><input type="number" min="-360" max="360" value="@N(appearance.TextureAngle)" @onchange='e=>ChangeMaterial("textureAngle",e)' /><small>°</small></label><button class="wide-button secondary" @onclick="RemoveBodyTexture">移除贴图</button>}
                    <p class="description">仅调整当前实体。贴图按毫米统一密度。默认等密度表面映射保留棋盘格比例，也可切换三向混合柔化接缝。</p>
                }
                <label class="field-label">项目名称</label><input class="text-input" value="@doc.Name" @onchange="Rename" maxlength="40" />
                @if (historyFeature is { } selectedStep)
                {
                    <div class="section-label">特征步骤 @(doc.Features.IndexOf(selectedStep) + 1)</div><div class="selection-card">@selectedStep.Label · @FeatureLimit(selectedStep)<br />@if(selectedStep.Mode=="chamfer"){<span>参照：实体棱边</span>}else{<span>来源：@(doc.Sketches.FirstOrDefault(s => s.Id == selectedStep.SketchId)?.Name)</span>}</div>
                }
                <div class="section-label">草图承载面</div><div class="selection-card">@SupportName</div>
                @if(selectedSketch is {} offsetSketch&&offsetSketch.Plane.FeatureId is null&&offsetSketch.Plane.SourceSketchId is null){<label class="number-field"><span>基准面偏移</span><input type="number" min="-1000" max="1000" value="@N(offsetSketch.Plane.Offset)" @onchange="SetSketchOffset" /><small>mm</small></label>}
                @if (editing is null)
                {
                    @if (pickingSketchPlane) { <div class="selection-card">请选择三维中的彩色网格面，或已有实体的平面。选择后自动对齐并进入草图。</div> }
                }
                else
                {
                    <div class="selection-card">属性参数可直接修改；只有明确标注的尺寸才成为约束，吸附点会建立重合关系。</div>
                    @if(editing.Entities.Count>0) {
                        <label class="field-label">编辑图元</label>
                        <select class="text-input" value="@profileId" @onchange="SelectEditingEntity">
                            @foreach(var item in editing.Entities) { <option value="@item.Id">@(item.Kind switch { "circle"=>"圆", "slot"=>"长圆槽", "ellipse"=>"椭圆","arc"=>"圆弧","polygon"=>"多边形","line"=>item.Construction?"参考线":"直线", _=>"矩形" }) @(editing.Entities.IndexOf(item)+1)</option> }
                        </select>
                    }
                }
                @if(editing is not null&&tool=="polygon") { <label class="field-label">新多边形边数</label><select class="text-input" value="@polygonSides" @onchange="SetPolygonSides">@for(var count=3;count<=12;count++){<option value="@count">@count 边形</option>}</select> }
                @if (entity is not null)
                {
                    <div class="section-label">草图图元</div><div class="selection-card">@ProfileName<br />@(selectedSketch?.Finished == true ? "图元用于编辑尺寸，区域用于生成特征" : "未标注尺寸仅为参数，不自动锁定大小")</div>
                    <div class="section-label">图元参数 <span>mm</span></div>
                    @if(entity.Kind is "circle" or "arc" or "polygon")
                    {
                        <label class="number-field"><span>@(entity.Kind=="circle"?"直径":"半径")</span><input type="number" min="@(entity.Kind=="circle"?2:1)" max="@(entity.Kind=="circle"?2000:1000)" value="@N(entity.Kind=="circle"?entity.Radius*2:entity.Radius)" @onchange='e => ChangeEntityParameter(entity.Kind=="circle"?"diameter":"radius",e)' /><small>mm</small></label>
                    }
                    else if(entity.Kind != "line")
                    {
                        <label class="number-field"><span>@(entity.Kind=="slot"?"总长":"宽度")</span><input type="number" min="1" max="1000" value="@N(entity.Width)" @onchange='e => ChangeEntityParameter("width",e)' /><small>mm</small></label>
                        <label class="number-field"><span>@(entity.Kind=="slot"?"槽宽":"高度")</span><input type="number" min="1" max="1000" value="@N(entity.Height)" @onchange='e => ChangeEntityParameter("height",e)' /><small>mm</small></label>
                    }
                    @if(entity.Kind is "slot" or "ellipse" or "polygon") { <label class="number-field"><span>方向角度</span><input type="number" min="-360" max="360" value="@N(entity.Angle)" @onchange='args=>ChangeEntityParameter("angle",args)' /><small>°</small></label> }
                    @if(entity.Kind=="polygon") { <label class="number-field"><span>边数</span><input type="number" min="3" max="12" step="1" value="@entity.Sides" @onchange='args=>ChangeEntityParameter("sides",args)' /></label> }
                    @if(entity.Kind=="arc") { <label class="number-field"><span>起始角度</span><input type="number" min="-360" max="360" value="@N(entity.StartAngle)" @onchange='args=>ChangeEntityParameter("startAngle",args)' /><small>°</small></label><label class="number-field"><span>扫角</span><input type="number" min="-359" max="359" value="@N(entity.SweepAngle)" @onchange='args=>ChangeEntityParameter("sweepAngle",args)' /><small>°</small></label> }
                    @if(entity.Kind=="line") { <label class="number-field"><span>长度</span><input type="number" min="1" max="1000" value="@N(EdgeValue(entity,0))" @onchange='args=>ChangeEntityParameter("length",args)' /><small>mm</small></label> }
                    <label class="number-field"><span>位置 X</span><input disabled="@(entity.FixedPoint != "none")" type="number" value="@N(entity.X)" @onchange='e => ChangeEntityParameter("x",e)' /><small>mm</small></label>
                    <label class="number-field"><span>位置 Y</span><input disabled="@(entity.FixedPoint != "none")" type="number" value="@N(entity.Y)" @onchange='e => ChangeEntityParameter("y",e)' /><small>mm</small></label>
                    @if(editing is not null)
                    {
                        <div class="section-label">几何约束</div>
                        <label class="field-label">固定点（保持当前位置）</label>
                        <select class="text-input" value="@entity.FixedPoint" @onchange="ChangeFixedPoint">
                            <option value="none">无 · 位置可移动</option>
                            @if(entity.Kind is "circle" or "arc" or "polygon" or "ellipse") { <option value="center">固定中心</option> }
                            else if(entity.Kind=="line") { <option value="start">固定起点</option><option value="end">固定终点</option> }
                            else { <option value="center">固定中心</option><option value="bottomLeft">固定左下角</option><option value="topLeft">固定左上角</option><option value="topRight">固定右上角</option><option value="bottomRight">固定右下角</option> }
                        </select>
                        @if(entity.Kind!="line")
                        {
                            <label class="field-label">中心到参考线的距离</label>
                            <select class="text-input" value="@(entity.ReferenceLineId??"")" @onchange="ChangeReferenceLine">
                                <option value="">无距离约束</option>
                                @foreach(var guide in selectedSketch!.Entities.Where(e=>e.Kind=="line")) { <option value="@guide.Id">参考线 @(selectedSketch.Entities.IndexOf(guide)+1)</option> }
                            </select>
                            @if(entity.ReferenceLineId is not null) { <label class="number-field"><span>有向距离</span><input type="number" min="-1000" max="1000" value="@N(entity.ReferenceOffset)" @onchange="ChangeReferenceOffset" /><small>mm</small></label> }
                        }
                        <p class="description">选择工具可直接拖边或角点：有可用尺寸自由度时缩放；对应尺寸已锁定且位置未固定时移动。橙色点为固定锚点，悬停可查看动作提示。</p>
                        @if(edgeIndex is { } constraintEdge && entity.DimensionedEdges.Contains(constraintEdge)) { <button class="wide-button secondary" @onclick="RemoveDimension">解除此尺寸约束</button> }
                    }
                    @if(entity.Coincidences.Count>0) {
                        <div class="section-label">重合约束 <span>@entity.Coincidences.Count 条</span></div>
                        @foreach(var relation in entity.Coincidences) {
                            <div @key="relation.Id" class="constraint-property-row"><span>@relation.Description</span><button class="delete-button" disabled="@(operation is not null||pickingSketchPlane||initializing||documentBusy||saving)" @onclick="()=>RemoveCoincidence(relation.Id)">解除</button></div>
                        }
                    }
                    @if(entity.ModelDimensions.Count>0) {
                        <div class="section-label">两条线之间的距离</div>
                        @foreach(var distance in entity.ModelDimensions) {
                            var dimension=distance.Index;
                            <label class="number-field"><span>@(distance.ReferenceEntityId is null?"实体—草图":"草图—草图")</span><input type="number" min="0" max="1000" value="@N(distance.Distance)" @onchange="args=>ChangeModelDistance(dimension,args)" /><small>mm</small></label>
                            @if(editing is not null) { <button class="delete-button" @onclick="()=>RemoveModelDimension(dimension)">解除此间距</button> }
                        }
                    }
                    <div class="section-label">轮廓边 <span>点击选择</span></div>
                    @for (int i = 0; i < entity.EdgeCount; i++)
                    {
                        var edge = i;
                        <button class="edge-row @(edgeIndex == edge ? "selected" : "")" @onclick="() => SelectEdge(selectedSketch!.Id, entity.Id, edge)"><span>@EdgeText(entity, edge)</span><small>@(entity.DimensionedEdges.Contains(edge) ? "驱动尺寸" : "未标注")</small></button>
                    }
                    @if (edgeIndex is { } index)
                    {
                        @if(entity.DimensionedEdges.Contains(index)) {
                        <div class="section-label">@EdgeName</div>
                        
                            <label class="number-field"><span>@(entity.Kind == "circle" ? "直径" : entity.Kind=="arc"?"半径":"长度")</span><input type="number" min="@(entity.Kind=="circle"?2:1)" max="@(entity.Kind=="circle"?2000:1000)" value="@N(EdgeValue(entity, index))" @onchange="ChangeDimension" /><small>mm</small></label>
                            <p class="description">驱动尺寸 · 修改后重建后续特征。 标注文字可在画布拖动。</p>
                        @if(entity.DimensionPlacements.ContainsKey(index)) { <button class="wide-button secondary" @onclick="ResetDimensionPlacement">恢复标注自动位置</button> }
                        }
                        @if (editing is not null && !entity.DimensionedEdges.Contains(index)) { <button class="wide-button secondary" @onclick="AddDimension">添加尺寸标注</button> }
                    }
                    @if (editing is not null) { <button class="delete-button" @onclick="DeleteProfile">⌫ 删除轮廓</button> }
                }
                <div class="info-card"><span>◇ 区域选择</span><p>交叉的线和圆会分割出独立封闭区域。结束草图后，点击需要的区域，Ctrl / Shift 可多选；标注尺寸不再是拉伸或切除的前置条件。</p></div>
            }
            @if (editing is null && selectedSketch is not null && regions.Count > 0)
            {
                <div class="section-label">封闭区域 <span>@regionKeys.Count / @regions.Count 已选</span></div>
                <div class="region-actions"><button @onclick="SelectAllRegions">全选区域</button><button @onclick="ClearRegions">清除</button></div>
                <div class="region-list">
                @foreach (var r in regions)
                {
                    <button class="region-row @(regionKeys.Contains(r.Key) ? "selected" : "")" @onclick="() => ToggleRegion(r.Key)"><span>@(regionKeys.Contains(r.Key) ? "☑" : "□") 区域 @(regions.IndexOf(r) + 1)</span><small>@N(r.Area) mm²</small></button>
                }
                </div>
            }
        </div>
    </aside>
    <footer><span class="status-dot"></span><span class="status-message" role="status">@message</span><div class="footer-right"><button title="导出本次运行的耗时和面片统计，不包含项目模型" @onclick="DownloadPerformanceReport">导出性能记录</button><span>@doc.Sketches.Count 个草图</span><span>@doc.Features.Count 个特征</span><strong>FORMA / CAD</strong></div></footer>
</div>

@if(showProjects) {
    <div class="project-dialog-backdrop"><section class="project-dialog" role="dialog" aria-modal="true" aria-label="后端项目">
        <div class="project-dialog-title"><div><span class="eyebrow">PROJECT LIBRARY</span><h2>打开项目</h2></div><button @onclick="()=>showProjects=false" aria-label="关闭">✕</button></div>
        <p>项目自动保存到后端，选择后可继续编辑。</p>
        <div class="project-list">
            @if(savedProjects.Count==0){<p>暂无已保存项目</p>}
            @foreach(var item in savedProjects) {
                <div class="project-library-row"><button class="project-list-item" disabled="@(documentBusy||saving)" @onclick="()=>LoadProject(item.Id)"><strong>@item.Name @(item.Id==projectId?"· 当前":"")</strong><span>@item.Sketches 个草图 · @item.Features 个特征</span><small>@item.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · 第 @item.Revision 版</small></button><button class="project-library-delete" disabled="@(documentBusy||saving)" title="删除此项目" aria-label="@($"删除项目 {item.Name}")" @onclick="()=>RequestProjectDeletion(item)"><CadIcon Name="delete" /></button></div>
            }
        </div>
        <div class="project-dialog-actions"><label class="file-button">导入本地备份<InputFile OnChange="Open" accept=".json,.cad" disabled="@(documentBusy||saving)" /></label><button disabled="@(documentBusy||saving)" @onclick="DownloadProject">下载当前备份</button><button disabled="@(documentBusy||saving)" @onclick="BeginSaveAs">另存为项目</button></div>
    </section></div>
}
@if(projectNameMode is not null) {
    <div class="project-dialog-backdrop"><section class="project-dialog project-name-dialog" role="dialog" aria-modal="true" aria-label="@(projectNameMode=="new"?"新建项目":projectNameMode=="rename"?"重命名当前零件":"另存为项目")">
        <div class="project-dialog-title"><h2>@(projectNameMode=="new"?"新建项目":projectNameMode=="rename"?"重命名当前零件":"另存为项目")</h2><button @onclick="()=>projectNameMode=null" aria-label="关闭">✕</button></div>
        <label class="field-label" for="project-name">项目名称</label><input id="project-name" class="text-input" @bind="projectNameInput" @bind:event="oninput" maxlength="40" autofocus @onkeydown="ProjectNameKey" />
        <p>编辑内容会自动保存到后端。</p>
        <div class="project-dialog-actions"><button disabled="@(documentBusy||saving||string.IsNullOrWhiteSpace(projectNameInput))" @onclick="ConfirmProjectName">@(projectNameMode=="new"?"创建项目":projectNameMode=="rename"?"确认重命名":"另存为")</button><button @onclick="()=>projectNameMode=null">取消</button></div>
    </section></div>
}
@if(deletionPlan is {} removal&&(removal.HasDependents||deletionError is not null)) {
    <div class="project-dialog-backdrop"><section class="project-dialog" role="dialog" aria-modal="true" aria-label="删除建模对象">
        <div class="project-dialog-title"><h2>删除 @removal.Label</h2><button aria-label="取消删除" @onclick="()=>deletionPlan=null">✕</button></div>
        <p>以下依赖项会一起删除，失效的关联约束会解除。可通过撤销恢复。</p><div class="deletion-items">@foreach(var item in removal.AffectedItems){<div>@item</div>}</div>@if(deletionError is not null){<p role="alert">@deletionError</p>}
        <div class="project-dialog-actions"><button disabled="@(documentBusy||saving)" @onclick="ConfirmTreeDeletion">删除对象及依赖项</button><button @onclick="()=>deletionPlan=null">取消</button></div>
    </section></div>
}
@if(projectToDelete is {} deletingProject){
    <div class="project-dialog-backdrop"><section class="project-dialog" role="dialog" aria-modal="true" aria-label="删除项目">
        <div class="project-dialog-title"><h2>删除项目</h2><button aria-label="取消删除" @onclick="()=>projectToDelete=null">✕</button></div>
        <strong>@deletingProject.Name</strong><p>将删除后端项目及保存备份。项目删除无法通过建模撤销恢复。</p>
        @if(projectDeleteError is not null){<p role="alert">@projectDeleteError</p>}
        <div class="project-dialog-actions"><button disabled="@(documentBusy||saving)" @onclick="ConfirmProjectDeletion">确认删除项目</button><button disabled="@(documentBusy||saving)" @onclick="()=>projectToDelete=null">取消</button></div>
    </section></div>
}
@code {
    CadDocument doc = new();
    CadProjectSummary? projectToDelete;
    string? projectDeleteError;
    CadDeletionPlan? deletionPlan;
    string? deletionError;
    bool documentBusy,initializing=true,disposed;
    bool projectRestoreFailed;
    bool CanUseBrowser=>!disposed&&CircuitState.IsConnected;
    string? projectNameMode;
    string projectNameInput="";
    Guid projectId=Guid.NewGuid();
    long serverRevision;
    string savedSnapshot="";
    bool saving,pendingSave,storageConflict,requiresRepair,showProjects,protectBrowserDraft;
    DateTimeOffset? lastSavedAt;
    string? storageMessage;
    List<CadProjectSummary> savedProjects=[];
    string StorageLabel=>projectRestoreFailed?"项目重建失败":saving?"正在保存":storageConflict?"保存冲突":pendingSave||storageMessage is not null?"尚未同步":serverRevision>0?"已保存到后端":"新项目";
    string? sketchId, profileId, operation;
    string? historyFeatureId;
    string? editingFeatureId;
    bool modelFaceSelected;
    CadFeature? historyFeature => doc.Features.FirstOrDefault(f => f.Id == historyFeatureId);
    int? edgeIndex;
    List<string> regionKeys = [];
    List<SketchRegionInfo> regions = [];
    SketchPlane? support;
    SketchPlane? targetFace;
    string endCondition = "blind";
    string featureMode="extrude",axis="Y";
    double revolveAngle=360,axisOffset;
    bool rotationAxisSelected,thinWall,pickingRotationAxis;
    CadModelEdgeReference? axisModelEdge;
    string? openProfileEntityId;
    string? sweepPickRole;
    string pathInterpolation="native",sweepOrientation="follow";
    double centerPathLength=50,centerPathAngle;
    double wallThickness=2;
    string wallSide="center";
    string? axisEntityId,axisSketchId,pathSketchId,pathEntityId;
    int axisEdgeIndex;
    List<CadLoftSection> loftSections=[];
    List<CadLoftChoice> loftChoices=[];
    CadChamferEdge? chamferEdge;
    List<CadChamferEdge> chamferEdges=[];
    string edgeTreatment="chamfer";
    double chamferAngle=45;
    List<CadBodyInfo> bodies=[];
    string? selectedBodyId;
    List<double>? selectedFacePoint;
    CadBodyInfo? selectedBody=>bodies.FirstOrDefault(body=>body.Id==selectedBodyId);
    bool UseTopologyBevel => featureMode=="chamfer" && edgeTreatment=="chamfer" && chamferEdges.Count>0
        && chamferEdges.All(edge=>edge.Kind=="line"&&edge.FaceA?.Face?.StartsWith("visual-cap|",StringComparison.Ordinal)!=true&&edge.FaceB?.Face?.StartsWith("visual-cap|",StringComparison.Ordinal)!=true)
        && (editingFeatureId is null||doc.Features.FirstOrDefault(f=>f.Id==editingFeatureId)?.TopologyBevel==true||!HasEdgeSurfaceReferences(editingFeatureId));
    CadFeature CurrentFeature()=>new(){Id=editingFeatureId??"preview",Kind=operation??"extrude",Mode=featureMode,SketchId=sketchId??"",RegionKeys=featureMode=="sweep"&&thinWall?new List<string>():regionKeys.ToList(),Depth=distance,EndCondition=endCondition,Reversed=reversed,TargetFace=targetFace,Angle=revolveAngle,Axis=axis,AxisOffset=axisOffset,AxisEntityId=axisEntityId,AxisSketchId=axisSketchId,AxisEdgeIndex=axisEdgeIndex,AxisModelEdge=axisModelEdge,ThinWall=thinWall,OpenProfileEntityId=openProfileEntityId,WallThickness=wallThickness,WallSide=wallSide,PathSketchId=pathSketchId,PathEntityId=pathEntityId,PathInterpolation=pathInterpolation,SweepOrientation=sweepOrientation,Sections=loftSections.Select(s=>new CadLoftSection{SketchId=s.SketchId,RegionKeys=s.RegionKeys.ToList(),Face=s.Face,FaceX=s.FaceX,FaceY=s.FaceY}).ToList(),ChamferEdge=chamferEdge,ChamferEdges=chamferEdges.ToList(),EdgeTreatment=edgeTreatment,ChamferAngle=chamferAngle,AppearanceSourceId=EdgeAppearanceSource(),TopologyBevel=UseTopologyBevel,VisualOnly=!UseTopologyBevel&&featureMode=="chamfer"&&(editingFeatureId is null||doc.Features.FirstOrDefault(f=>f.Id==editingFeatureId)?.VisualOnly==true||!HasEdgeSurfaceReferences(editingFeatureId))};
    bool reversed, pickingTarget;
    bool pickingSketchPlane;
    FeaturePreviewInfo previewState = new();
    CadSketch? editing => doc.Sketches.FirstOrDefault(s => !s.Finished);
    CadSketch? selectedSketch => doc.Sketches.FirstOrDefault(s => s.Id == sketchId);
    SketchEntity? entity => selectedSketch?.Entities.FirstOrDefault(e => e.Id == profileId);
