    {
        var success=await ApplyDimensionValue(sid,pid,edge,value);RefreshUi();return success?null:message;
    }
    [JSInvokable] public async Task<string?> CreatePlacedDimension(string sid,string pid,int edge,ModelEdgeDimension? pair,double offsetX,double offsetY,double value)
    {
        var sketch=editing;var target=sketch?.Entities.FirstOrDefault(candidate=>candidate.Id==pid);
        if(sketch?.Id!=sid||tool!="dimension"||target is null)return "请在当前草图中选择边。";
        var ok=await Mutate(()=>{
            if(!double.IsFinite(value)||!double.IsFinite(offsetX)||!double.IsFinite(offsetY))throw new ArgumentException("请输入有效尺寸。");
            var index=edge;
            if(pair is not null){
                if(value<0||!target.IsStraightEdge(pair.Edge))throw new ArgumentException("请选择有效直边，距离不能小于零。");
                var reference=pair.ReferenceEntityId is null?null:sketch.Entities.FirstOrDefault(candidate=>candidate.Id==pair.ReferenceEntityId);
                if(pair.ReferenceEntityId is not null&&(reference is null||!reference.IsStraightEdge(pair.ReferenceEdge)||(reference.Id==pid&&pair.ReferenceEdge==pair.Edge)))throw new ArgumentException("请选择两条不同的草图直边。");
                if(target.ModelDimensions.Any(d=>d.Edge==pair.Edge&&d.ReferenceEntityId==pair.ReferenceEntityId&&(pair.ReferenceEntityId is not null?d.ReferenceEdge==pair.ReferenceEdge:d.ReferenceFace.FeatureId==pair.ReferenceFace.FeatureId&&d.ReferenceFace.Face==pair.ReferenceFace.Face))||(reference?.ModelDimensions.Any(d=>d.Edge==pair.ReferenceEdge&&d.ReferenceEntityId==pid&&d.ReferenceEdge==pair.Edge)??false))throw new ArgumentException("两条边已有标注，请双击原标注修改。");
                index=target.ModelDimensions.Count==0?-2:target.ModelDimensions.Min(d=>d.Index)-1;
                pair.Index=index;pair.Distance=value;target.ModelDimensions.Add(pair);
            } else {
                if(edge<0||edge>=target.EdgeCount||value<1)throw new ArgumentException("请选择有效草图边，尺寸至少为 1 mm。");
                if(target.DimensionedEdges.Contains(edge))throw new ArgumentException("该边已有标注，请双击原标注修改。");
                var anchor=target.Anchor();
                if(target.Kind=="circle")target.Radius=value/2;else if(target.Kind=="arc")target.Radius=value;else if(target.Kind=="polygon")target.Radius=value/(2*Math.Sin(Math.PI/target.Sides));
                else if(target.Kind=="line"){var length=EdgeValue(target,0);target.Width*=value/length;target.Height*=value/length;}
                else if(edge%2==0)target.Width=value;else target.Height=value;
                target.KeepAnchor(anchor);target.DimensionedEdges.Add(edge);
            }
            target.DimensionPlacements[index]=new(){X=offsetX,Y=offsetY};
            sketchId=sid;profileId=pid;edgeIndex=pair is null?edge:null;support=sketch.Plane;
        },"尺寸已标注 · 可以继续选择新的边");
        RefreshUi();return ok?null:message;
    }
